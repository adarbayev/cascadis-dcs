# Copy this file to .env for local development.
# Optional. When blank, the backend uses Ember's public yearly CSV.
EMBER_API_KEY=

# Ember's public yearly CSV works without a key. When a key is supplied, the
# backend prefers the documented yearly API and keeps the key server-side.
EMBER_DATA_YEAR=2025

# Local paths and service settings
DC_COOLING_DB_PATH=var/cooling_location.sqlite3
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=5173
# Optional browser API override. Blank uses Vite's local /api proxy.
VITE_API_BASE_URL=
# Optional basemap style override for controlled deployments and failure testing.
VITE_MAP_STYLE_URL=

# Optional source controls
AQUEDUCT_CACHE_TTL_HOURS=168
GRID_CACHE_TTL_HOURS=168
SOURCE_REQUEST_TIMEOUT_SECONDS=12
SOURCE_RETRY_ATTEMPTS=3
ASSESSMENT_CONCURRENCY=8
